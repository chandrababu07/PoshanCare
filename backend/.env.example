# PoshanCare Backend Environment Configuration Example
# Copy to .env for local overrides. Do NOT commit real secrets to version control.

# General Configuration
PROJECT_NAME="PoshanCare API"
ENVIRONMENT="production" # "development" | "staging" | "production"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Production Async PostgreSQL database connection string format:
# DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>"
DATABASE_URL="sqlite+aiosqlite:///./poshancare.db"

# Security & Authentication Settings
# Mandatory 32+ character random secret key for production JWT signing
SECRET_KEY="replace_with_a_secure_random_32_character_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true # Set to true when serving HTTPS in production
COOKIE_SAMESITE="lax"
RATE_LIMIT_LOGIN_PER_MINUTE=10
ENABLE_SECURITY_HEADERS=true

# CORS Trusted Whitelist Origins (JSON array string or comma-separated URLs)
# Example: CORS_ORIGINS=["https://app.poshancare.com","https://poshancare.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

